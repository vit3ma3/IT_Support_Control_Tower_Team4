// IT Support Control Tower — C4 Component (C3): контейнер «Модуль импорта и проверки CSV».
// Рендер: neato -n -Tpng -Gdpi=150 c4_component.dot -o ../images/c4_component.png
// Координаты узлов заданы вручную (pos), чтобы связи не пересекались.
digraph c4_component {
  graph [fontname="Arial", splines=true, outputorder=edgesfirst, pad=0.4,
         label=<<b>IT Support Control Tower — C4 Component (C3): модуль импорта и проверки CSV</b>>, labelloc=t, fontsize=22]
  node  [shape=box, style="rounded,filled", fontname="Arial", fontsize=12, fontcolor=white, margin="0.2,0.12", width=3.3, height=1.1, fixedsize=true, penwidth=1.5]
  edge  [fontname="Arial", fontsize=11, color="#6E7B8B", fontcolor="#33404D", arrowsize=0.9, penwidth=1.3]

  node [fillcolor="#0D4778", color="#0D4778"]
  analyst [pos="180,920", label=<<b>Аналитик</b><br/><font point-size="10">[Person]</font><br/>Выбирает файлы, смотрит итог>]

  node [fillcolor="#8C8296", color="#8C8296"]
  csv [pos="-300,560", label=<<b>Синтетические CSV-файлы</b><br/><font point-size="10">[Внешний источник]</font><br/>tickets, events, sla_targets>]

  node [fillcolor="#20A4D6", color="#1686B3"]
  refs    [pos="1780,420",  label=<<b>2. Справочники и нормативы SLA</b><br/><font point-size="10">[Container]</font><br/>Очереди, исполнители, P1–P3>]
  ib      [pos="720,-170",  label=<<b>Информационная база 1С</b><br/><font point-size="10">[Container]</font><br/>Обращения и события>, shape=cylinder, style=filled, height=1.2]
  journal [pos="1260,-170", label=<<b>5. Журнал загрузок и расчётов</b><br/><font point-size="10">[Container]</font><br/>Итоги и протокол ошибок>]

  node [fillcolor="#7FCCEB", color="#1686B3", fontcolor="#0B3350"]
  form [pos="180,720",  label=<<b>Форма «Импорт данных»</b><br/><font point-size="10">[Component, клиент]</font><br/>Файлы, итог, протокол>]
  k1   [pos="180,560",  label=<<b>К1. Читатель CSV</b><br/><font point-size="10">[Component]</font><br/>UTF-8, «,», формат даты>]
  k2   [pos="720,420",  label=<<b>К2. Структура и поля</b><br/><font point-size="10">[Component] V1, V2</font><br/>Колонки, обязательные поля>]
  k4   [pos="180,240",  label=<<b>К4. Хронология</b><br/><font point-size="10">[Component] V4</font><br/>Порядок событий, closed_at>]
  k5   [pos="540,240",  label=<<b>К5. Уникальность</b><br/><font point-size="10">[Component] V5</font><br/>Один first_response, resolved>]
  k3   [pos="900,240",  label=<<b>К3. Ссылки</b><br/><font point-size="10">[Component] V3</font><br/>Очереди, исполнители>]
  k6   [pos="1260,240", label=<<b>К6. Нормативы SLA</b><br/><font point-size="10">[Component] V6</font><br/>Норматив для приоритета>]
  k7   [pos="720,60",   label=<<b>К7. Загрузчик</b><br/><font point-size="10">[Component]</font><br/>Запись без дублей (ADR-0003)>]
  k8   [pos="1260,60",  label=<<b>К8. Протоколист</b><br/><font point-size="10">[Component]</font><br/>Итоги и строки ошибок>]

  boundary [pos="720,385", shape=box, style="rounded,dashed", color="#8C8C8C", fillcolor=none, width=21.4, height=11.2, fixedsize=true, label=""]
  btitle [pos="720,770", shape=plaintext, style="", fontcolor="#0D4778", width=7, height=0.4,
          label=<<b>1. Модуль импорта и проверки CSV</b> — обработка 1С>]

  analyst -> form [label="Выбор файлов, «Загрузить»"]
  form    -> k1   [label="Файлы"]
  csv     -> k1   [label="CSV, UTF-8"]
  k1      -> k2   [label="Строки с заголовком"]
  k2 -> k4; k2 -> k5; k2 -> k3; k2 -> k6
  k4 -> k7; k5 -> k7; k3 -> k7; k6 -> k7
  k3      -> refs [label="Очереди и исполнители"]
  k6      -> refs [taillabel="Нормативы", labeldistance=5, labelangle=25]
  k7      -> k8   [label="Итоги и ошибки"]
  k7      -> ib   [label="Новые обращения и события"]
  k8      -> journal [label="Запись журнала"]

  legend [pos="1700,-190", shape=plaintext, style="", fixedsize=false, fontcolor=black, label=<
    <table border="1" cellborder="0" cellspacing="3" color="#B0B0B0" bgcolor="white">
      <tr><td colspan="2"><b>Легенда</b></td></tr>
      <tr><td bgcolor="#0D4778" width="22"> </td><td align="left">Человек (Person)</td></tr>
      <tr><td bgcolor="#7FCCEB"> </td><td align="left">Компонент модуля импорта (каждый — задача плана)</td></tr>
      <tr><td bgcolor="#20A4D6"> </td><td align="left">Другие контейнеры системы</td></tr>
      <tr><td bgcolor="#8C8296"> </td><td align="left">Внешний источник</td></tr>
      <tr><td colspan="2" align="left"><b>Линии</b></td></tr>
      <tr><td>——▶</td><td align="left">Сплошная стрелка — вызов или передача данных<br align="left"/>(стрелка указывает направление)</td></tr>
      <tr><td>┌ ┄ ┐</td><td align="left">Пунктирная рамка — граница контейнера «Модуль импорта»</td></tr>
      <tr><td colspan="2" align="left">Ошибки проверок К2 – К6 идут в К8 через К7;<br align="left"/>итог загрузки возвращается в форму</td></tr>
    </table>>]
}
