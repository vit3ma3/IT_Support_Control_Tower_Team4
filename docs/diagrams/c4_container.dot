// IT Support Control Tower — C4 Container (C2), v2. Рендер: neato -n -Tpng -Gdpi=150 c4_container.dot -o ../images/c4_container.png
// Координаты узлов заданы вручную (pos), чтобы связи не пересекались.
digraph c4_container {
  graph [fontname="Arial", splines=true, outputorder=edgesfirst, pad=0.4,
         label=<<b>IT Support Control Tower — C4 Container (C2), v2</b>>, labelloc=t, fontsize=22]
  node  [shape=box, style="rounded,filled", fontname="Arial", fontsize=12, fontcolor=white, margin="0.2,0.12", width=3.3, height=1.1, fixedsize=true, penwidth=1.5]
  edge  [fontname="Arial", fontsize=11, color="#6E7B8B", fontcolor="#33404D", arrowsize=0.9, penwidth=1.3]

  node [fillcolor="#0D4778", color="#0D4778"]
  analyst    [pos="180,860",  label=<<b>Аналитик</b><br/><font point-size="10">[Person]</font><br/>Импорт, отчёт, экспорт>]
  queue_lead [pos="560,860",  label=<<b>Руководитель очереди</b><br/><font point-size="10">[Person]</font><br/>Отчёт по своей очереди>]
  manager    [pos="940,860",  label=<<b>Руководитель ИТ-поддержки</b><br/><font point-size="10">[Person]</font><br/>KPI; нормативы SLA>]
  admin      [pos="1320,860", label=<<b>Администратор 1С</b><br/><font point-size="10">[Person]</font><br/>Справочники и роли>]

  node [fillcolor="#8C8296", color="#8C8296"]
  csv        [pos="-280,620", label=<<b>Синтетические CSV-файлы</b><br/><font point-size="10">[Внешний источник]</font><br/>tickets, events, sla_targets>]
  export_rcv [pos="1800,380", label=<<b>Получатель выгрузки</b><br/><font point-size="10">[Внешняя система]</font><br/>Коллеги или BI-инструмент>]
  sd         [pos="-280,380", label=<<b>Service Desk (Jira, OTRS)</b><br/><font point-size="10">[Внешняя система]</font><br/>Вне MVP (W-01)>, fillcolor="#D9D4DE", fontcolor="#4A4352", style="rounded,filled,dashed"]

  node [fillcolor="#20A4D6", color="#1686B3"]
  import  [pos="180,620",  label=<<b>1. Импорт и проверка CSV</b><br/><font point-size="10">[Обработка 1С]</font><br/>6 проверок, запись без дублей>]
  report  [pos="750,620",  label=<<b>4. Отчёт и экспорт</b><br/><font point-size="10">[Форма, СКД]</font><br/>Свод, диаграммы, фильтры, CSV>]
  refs    [pos="1320,620", label=<<b>2. Справочники и нормативы SLA</b><br/><font point-size="10">[Справочники, регистр]</font><br/>Очереди, исполнители, P1–P3>]
  calc    [pos="1320,380",  label=<<b>3. Расчёт SLA и загрузки</b><br/><font point-size="10">[Модуль, регламентное задание]</font><br/>Реакция, решение, загрузка>]
  journal [pos="180,380",  label=<<b>5. Журнал загрузок и расчётов</b><br/><font point-size="10">[Регистр, форма]</font><br/>Итоги, ошибки, пороги>]
  ib      [pos="750,140",  label=<<b>Информационная база 1С</b><br/><font point-size="10">[Хранилище]</font><br/>Все данные системы>, shape=cylinder, style=filled, height=1.2]

  boundary [pos="750,390", shape=box, style="rounded,dashed", color="#8C8C8C", fillcolor=none, fontcolor="#0D4778", width=20.4, height=8.6, fixedsize=true,
            label="", xlabel=""]
  btitle [pos="750,685", shape=plaintext, style="", fontcolor="#0D4778", width=6, height=0.4,
          label=<<b>IT Support Control Tower</b> — система на 1С:Предприятие 8.3>]

  analyst    -> import  [label="Загрузка CSV"]
  queue_lead -> report  [label="Отчёт по очереди"]
  manager    -> report  [label="Просмотр KPI"]
  manager    -> refs    [label="Нормативы"]
  admin      -> refs    [label="Справочники, роли"]
  analyst    -> report  [label="Фильтры, экспорт"]
  csv        -> import  [label="CSV, UTF-8"]
  report     -> export_rcv [headlabel="CSV, 6 полей", labeldistance=9, labelangle=-12]
  import     -> journal [label="Итоги и ошибки"]
  import     -> ib      [label="Обращения, события"]
  refs       -> calc    [taillabel="Нормативы", labeldistance=4.5, labelangle=-35]
  calc       -> ib      [label="Результаты расчёта"]
  report     -> ib      [label="Чтение результатов"]
  sd         -> import  [label="Только после согласования", style=dashed, color="#8C8296"]

  legend [pos="1830,110", shape=plaintext, style="", fontcolor=black, width=4.2, height=1.6, fixedsize=false, label=<
    <table border="1" cellborder="0" cellspacing="3" color="#B0B0B0" bgcolor="white">
      <tr><td colspan="2"><b>Легенда</b></td></tr>
      <tr><td bgcolor="#0D4778" width="22"> </td><td align="left">Человек (Person)</td></tr>
      <tr><td bgcolor="#20A4D6"> </td><td align="left">Контейнер системы = пакет работ 1–5</td></tr>
      <tr><td bgcolor="#8C8296"> </td><td align="left">Внешняя система</td></tr>
      <tr><td bgcolor="#D9D4DE"> </td><td align="left">Внешняя система вне MVP</td></tr>
      <tr><td colspan="2" align="left"><b>Линии</b></td></tr>
      <tr><td>——▶</td><td align="left">Сплошная стрелка — связь в MVP; стрелка указывает, куда идут данные или действие</td></tr>
      <tr><td>- - ▶</td><td align="left">Пунктирная стрелка — возможная будущая связь, вне MVP</td></tr>
      <tr><td>┌ ┄ ┐</td><td align="left">Пунктирная рамка вокруг блоков — граница системы</td></tr>
      <tr><td>┌ ┄ ┐</td><td align="left">Пунктирная рамка у блока — внешняя система вне MVP</td></tr>
    </table>>]
}
